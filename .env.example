DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost

POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-too

# Bootstrapped by docker-entrypoint.sh on first run if the user doesn't
# already exist. Leave DJANGO_SUPERUSER_PASSWORD unset to skip creation.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_NICKNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me!1
